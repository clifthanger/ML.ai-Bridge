# ML AI Code API key.
#
# Leave this EMPTY. Paste your key when the Get started wizard asks for it
# (console menu [g], or `python mlai_kit.py get-started`) and the tool writes
# it here for you.
#
# Get a key at https://code.ml.ai -> Settings -> API keys
MLAI_API_KEY=

# Optional: overrides `client_key` in config.json — the key this bridge demands
# on /v1/* from its own clients. Managed by the console (keys screen, option 6).
# MLAI_BRIDGE_KEY=
